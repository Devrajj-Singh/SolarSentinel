{
  "nasa": {
    "donki_api_base": "https://ccmc.gsfc.nasa.gov/DONKI-API/get",
    "endpoints": {
      "cme": "/CME",
      "solar_flare": "/FLR",
      "geomagnetic_storm": "/GST"
    },
    "default_date_range_days": 7,
    "note": "DONKI API requires no authentication key as of Sep 2026 migration"
  },
  "ai_service": {
    "provider": "groq",
    "model": "openai/gpt-oss-120b",
    "endpoint": "https://api.groq.com/openai/v1/chat/completions",
    "api_key": "YOUR_GROQ_API_KEY_HERE",
    "temperature": 0.2,
    "max_tokens": 2048,
    "note": "Powered by Groq LPU inference. Can also be set via GROQ_API_KEY environment variable"
  },
  "gemini_fallback": {
    "api_key": "YOUR_GEMINI_API_KEY_HERE",
    "model": "gemini-2.5-flash",
    "temperature": 0.2,
    "max_output_tokens": 1024
  },
  "risk_engine": {
    "high_confidence_threshold": 0.8,
    "medium_confidence_threshold": 0.5,
    "severity_weights": {
      "S1": "LOW",
      "S2": "LOW",
      "S3": "MEDIUM",
      "S4": "HIGH",
      "S5": "HIGH"
    }
  },
  "output": {
    "excel_log_path": "output/logs/events_log.xlsx",
    "report_directory": "output/reports/"
  }
}
